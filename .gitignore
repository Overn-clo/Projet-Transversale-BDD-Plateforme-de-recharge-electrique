# ============================================================================
# PROJET URBANWATT - .gitignore
# ============================================================================

# 1. Secrets et variables d'environnement (Critère de sécurité obligatoire)
.env
*.env
!.env.example
infra/.env

# 2. Sauvegardes PostgreSQL et dumps (Interdiction de publier les dumps)
sauvegardes/*.dump
sauvegardes/*.sql
sauvegardes/*.bak
sauvegardes/*.tar
sauvegardes/*.gz
!sauvegardes/procedure_sauvegarde.md

# 3. Environnement Python / FastAPI (Dossier app/)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# 4. Volumes locaux Docker et logs PostgreSQL
infra/pgdata/
*.log

# 5. Fichiers système et éditeurs (OS / IDE)
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
