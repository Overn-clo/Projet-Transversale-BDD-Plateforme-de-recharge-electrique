#Pour configurer la base de donnée URBANWATT il nous faut :

#Configuration du Super-Administrateur PostgreSQL (postgres)
# le nom de la bdd qu'on va utiliser
POSTGRES_DB=urbanwatt
# un user
POSTGRES_USER=postgres
# un mdp
POSTGRES_PASSWORD=MOT_DE_PASSE_ADMIN_A_CHANGER

#Configuration du compte applicatif restreint (utilisé par l'API)
DB_HOST=localhost
# le port sur lequel on va communiquer avec PostgreSQL
DB_PORT=5432
DB_NAME=urbanwatt
DB_USER=urbanwatt_app
DB_PASSWORD=MOT_DE_PASSE_APP_A_CHANGER